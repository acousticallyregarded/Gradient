# Optional. Without it, Gradient runs on the built-in stub engine.
ANTHROPIC_API_KEY=
# Optional model override (default: claude-opus-5-5)
GRADIENT_MODEL=
# "Claim your agent" (verified KOL agents). Needed only on the deployed server.
# Random string, 16+ chars, signs claim codes and tokens.
CLAIM_SECRET=
# Random string, 12+ chars, unlocks /admin (drafts) and takedowns.
ADMIN_KEY=
# Shared storage for verified agents and drafts: Upstash Redis (free tier) or Vercel KV.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Real voice notes (optional; without these, voice notes use the browser's built-in voice).
# VOICE_PROVIDER=openai or elevenlabs
VOICE_PROVIDER=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
# ElevenLabs voice ids from your Voice Library: deep voices, then "|", then lighter ones
ELEVENLABS_VOICES=
# Max characters turned into audio per day across the whole site (~150 chars per note)
VOICE_DAILY_CHAR_LIMIT=200000
